{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Social UNA",
      "type": "debugpy",
      "request": "launch",
      "module": "social_una.principal",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}"
      },
      "linux": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}"
        }
      },
      "osx": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}"
        }
      }
    }
  ]
}