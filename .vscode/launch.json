{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: archivo actual (Social UNA)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}"
      },
      "linux": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}"
        }
      },
      "osx": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}"
        }
      }
    }
  ]
}